# Existing Neon branch Managed Auth URL (includes the database/auth path)
NEON_AUTH_BASE_URL=https://YOUR-NEON-AUTH-HOST/YOUR-DATABASE/auth
# Generate a unique secret; do not commit it
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
# Comma-separated exact email addresses allowed into /admin
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
